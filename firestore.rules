rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string &&
             id.size() >= 1 &&
             id.size() <= 128 &&
             id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Bootstrapped Admin gate: requires verified email strictly matching farahrifa58@gmail.com
    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == 'farahrifa58@gmail.com';
    }

    function isValidDeviceIdList(listVal) {
      return listVal is list &&
             listVal.size() <= 10 &&
             (listVal.size() == 0 || listVal[0] is string);
    }

    function isValidActivationCodeCreate(data) {
      return data.keys().hasAll(['status', 'createdByUid', 'createdAt']) &&
             data.keys().hasOnly(['status', 'createdByUid', 'createdAt']) &&
             data.status is string &&
             data.status == 'available' &&
             data.createdByUid is string &&
             data.createdByUid == request.auth.uid &&
             data.createdByUid.size() >= 1 &&
             data.createdByUid.size() <= 128 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time;
    }

    function isValidActivationCodeUpdate(data) {
      return data.status is string &&
             data.status in ['available', 'used'] &&
             (!('createdByUid' in data) || (data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128)) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('usedByUid' in data) || data.usedByUid == null || (data.usedByUid is string && data.usedByUid.size() <= 128)) &&
             (!('usedByEmail' in data) || data.usedByEmail == null || (data.usedByEmail is string && data.usedByEmail.size() <= 254)) &&
             (!('buyerEmail' in data) || data.buyerEmail == null || (data.buyerEmail is string && data.buyerEmail.size() <= 254)) &&
             (!('businessName' in data) || data.businessName == null || (data.businessName is string && data.businessName.size() <= 120)) &&
             (!('registeredDeviceId' in data) || data.registeredDeviceId == null || (data.registeredDeviceId is string && data.registeredDeviceId.size() <= 128)) &&
             (!('registeredDeviceIds' in data) || data.registeredDeviceIds == null || isValidDeviceIdList(data.registeredDeviceIds)) &&
             (!('usedAt' in data) || data.usedAt == null || (data.usedAt is timestamp && data.usedAt <= request.time)) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidUserDocument(data) {
      return (!('businessName' in data) || data.businessName == null || (data.businessName is string && data.businessName.size() <= 120)) &&
             (!('namaUsaha' in data) || data.namaUsaha == null || (data.namaUsaha is string && data.namaUsaha.size() <= 120)) &&
             (!('shopName' in data) || data.shopName == null || (data.shopName is string && data.shopName.size() <= 120)) &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 254)) &&
             (!('activationCode' in data) || data.activationCode == null || (data.activationCode is string && data.activationCode.size() <= 64)) &&
             (!('licenseCode' in data) || data.licenseCode == null || (data.licenseCode is string && data.licenseCode.size() <= 64)) &&
             (!('registeredDeviceId' in data) || data.registeredDeviceId == null || (data.registeredDeviceId is string && data.registeredDeviceId.size() <= 128)) &&
             (!('registeredDeviceIds' in data) || data.registeredDeviceIds == null || isValidDeviceIdList(data.registeredDeviceIds)) &&
             (!('createdAt' in data) || data.createdAt == null || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    match /activation_codes/{codeId} {
      allow get: if isAdmin() && isValidId(codeId);
      allow list: if isAdmin();

      allow create: if isAdmin() &&
                       isValidId(codeId) &&
                       isValidActivationCodeCreate(incoming());

      allow update: if isAdmin() &&
                       isValidId(codeId) &&
                       isValidActivationCodeUpdate(incoming()) &&
                       (!('createdByUid' in existing()) || incoming().createdByUid == existing().createdByUid) &&
                       (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'status', 'usedByUid', 'usedByEmail', 'buyerEmail', 'businessName',
                         'registeredDeviceId', 'registeredDeviceIds', 'usedAt', 'updatedAt'
                       ]);

      // Only codes that are still 'available' may be deleted
      allow delete: if isAdmin() &&
                       isValidId(codeId) &&
                       existing().status == 'available';
    }

    match /users/{userId} {
      allow get: if (isAdmin() || (isSignedIn() && request.auth.uid == userId)) && isValidId(userId);
      allow list: if isAdmin();

      allow create: if isAdmin() &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['email', 'registeredDeviceId', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly([
                         'businessName', 'namaUsaha', 'shopName', 'email',
                         'activationCode', 'licenseCode', 'registeredDeviceId', 'registeredDeviceIds',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserDocument(incoming()) &&
                       incoming().email is string &&
                       incoming().email.size() >= 3 &&
                       incoming().registeredDeviceId is string &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time;

      // Admin Reset Perangkat action: clears registeredDeviceId & registeredDeviceIds and stamps updatedAt
      allow update: if isAdmin() &&
                       isValidId(userId) &&
                       isValidUserDocument(incoming()) &&
                       incoming().registeredDeviceId is string &&
                       incoming().registeredDeviceId.size() <= 128 &&
                       (!('registeredDeviceIds' in incoming()) || isValidDeviceIdList(incoming().registeredDeviceIds)) &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'registeredDeviceId', 'registeredDeviceIds', 'updatedAt'
                       ]);

      allow delete: if false;
    }
  }
}
